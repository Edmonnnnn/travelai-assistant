###############################################################################
# TravelAI Assistant - Environment Configuration
#
# This file documents every env var used by docker-compose/scripts or code.
# Copy this file to `.env` and adjust values if needed.
# The only supported env file is the repo root `.env`. `infra/.env` is deprecated.
###############################################################################

###############################################################################
# REQUIRED (used by docker-compose + scripts)
###############################################################################

# Why: configures the Postgres container and backend connection string.
POSTGRES_DB=travelai

# Why: Postgres user for the local container.
POSTGRES_USER=travelai

# Why: Postgres password for the local container.
POSTGRES_PASSWORD=change_me

# Why: host port for backend service (docker-compose publish).
BACKEND_PORT=8810

# Why: host port for frontend service (docker-compose publish).
FRONTEND_PORT=3000

###############################################################################
# OPTIONAL (compose defaults are OK)
###############################################################################

# Why: host port for Postgres (docker-compose publish).
DB_PORT=5432

# Why: run seed step in backend entrypoint (true/false).
SEED_DATA=false

# Why: Next.js API routes use this to reach backend inside Docker network.
# In compose it is set explicitly; usually leave as default.
BACKEND_INTERNAL_URL=http://backend:8810

# Why: passed into backend container; currently unused by code.
OPENAI_API_KEY=

# Why: passed into backend container; currently unused by code.
QDRANT_URL=

# Why: passed into backend container; currently unused by code.
PGVECTOR_DSN=

###############################################################################
# PROD / NON-COMPOSE
###############################################################################

# Why: required by backend when running outside docker-compose.
# Example: postgresql+psycopg2://travelai:change_me@localhost:5432/travelai
# DATABASE_URL=
